# Inventory only. No production values or default legal decisions.
# Inject separate secrets into web, worker and authorized operator runtimes.
# Do not load this file as production configuration.
APPLICATION_DATABASE_URL=
APPLICATION_ENCRYPTION_KEY=
APPLICATION_ABUSE_KEY=
APPLICATION_DATA_OWNER=
APPLICATION_RETENTION_DAYS=
APPLICATION_ALLOW_LOCAL=false
# Remain false until DB, keys, SMTP, retention and legal/staging checks pass.
APPLICATION_ACCEPTING_SUBMISSIONS=false
# Set after verifying the actual ingress header rewriting and proxy chain.
APPLICATION_TRUSTED_PROXY_HOPS=0
# Worker only; do not expose these to the browser or unrelated processes.
APPLICATION_SMTP_HOST=
APPLICATION_SMTP_PORT=
APPLICATION_SMTP_USER=
APPLICATION_SMTP_PASS=
APPLICATION_NOTIFICATION_TO=
APPLICATION_NOTIFICATION_FROM=
# Authorized operator runtime only. This alias is not authentication.
APPLICATION_OPERATOR_ID=
